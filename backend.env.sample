# ===================================================
# CareerDesk Backend - Environment Variables (SAMPLE)
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to version control.
# ===================================================

# --- App Config ---
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Cloudinary Settings ---
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# --- Database ---
# Local SQLite fallback: sqlite:///./careerdesk.db
# Supabase PostgreSQL Pooler format: postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./careerdesk.db

# --- LLM Providers (free-tier) ---
# Use at least one. If both are set, OPENROUTER is used as primary, GROQ as fallback.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Job Board APIs ---
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
# RemoteOK and Arbeitnow do not require API keys (public endpoints)

# --- Grammar/Spelling Check ---
LANGUAGETOOL_API_URL=https://api.languagetool.org/v2/check

# --- Location API Token ---
COUNTRY_STATE_API_TOKEN=your_country_state_city_api_token_here

# --- Caching ---
JOB_SEARCH_CACHE_TTL_SECONDS=3600
LLM_RESULT_CACHE_TTL_SECONDS=86400

# --- File Upload Limits ---
MAX_RESUME_FILE_SIZE_MB=5
ALLOWED_RESUME_EXTENSIONS=.pdf,.docx
USE_MINERU_PARSER=True
MINERU_API_TOKEN=your_mineru_token_here
